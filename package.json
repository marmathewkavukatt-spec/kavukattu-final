{
  "name": "church",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/startup-info.js && next dev",
    "build": "node scripts/next-build-safe.js",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "create-admin": "node scripts/create-admin.js",
    "compress-images": "node scripts/compress-existing-images.js",
    "optimize:gallery": "node scripts/optimize-gallery-performance.js",
    "test:performance": "node scripts/test-performance.js",
    "optimize:db": "node scripts/optimize-db-calls.js",
    "warmup:cache": "node scripts/warmup-cache.js",
    "setup:security": "node scripts/setup-security.js",
    "security:audit": "npm audit && node scripts/setup-security.js",
    "security:check": "node -e \"require('./scripts/setup-security.js').validateSecurity()\"",
    "seo:audit": "node scripts/seo-audit.js",
    "seo:check": "node scripts/seo-audit.js",
    "server:info": "node scripts/show-server-info.js",
    "build:production": "node scripts/production-deploy.js",
    "perf:analyze": "node scripts/apply-performance-optimizations.js",
    "perf:test": "echo 'Run: autocannon -c 100 -d 30 https://marmathewkavukatt.org'",
    "fix:chunks": "node scripts/fix-chunk-errors.js",
    "diagnose:build": "node scripts/diagnose-build.js",
    "verify:images": "node scripts/verify-images.js",
    "verify:deployment": "node scripts/post-deploy-verify.js",
    "deploy:prepare": "node scripts/prepare-hostinger-deploy.js",
    "diagnose:deployment": "node scripts/diagnose-deployment.js",
    "deploy:emergency": "node scripts/prepare-emergency-deploy.js",
    "test:spiritual-legacy": "node scripts/test-spiritual-legacy.js",
    "perf:optimize": "node scripts/optimize-performance.js",

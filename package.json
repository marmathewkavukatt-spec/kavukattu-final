    "test:mime": "bash scripts/test-mime-types.sh"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@jridgewell/gen-mapping": "^0.3.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2",
    "cloudinary": "^2.9.0",
    "framer-motion": "^11",
    "jose": "^5",
    "lucide-react": "^0.575.0",
    "next": "14.2.35",

    "postcss": "^8",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^16.6.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35"
  }
